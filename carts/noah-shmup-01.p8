pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--main

booted=false
function _init()
  if not booted then
  	cartdata("noahshmup01_save")
  	booted=true
  end
  dscore=dget(0)

  gg=0
  p={ x=60,y=100,w=8,h=8,
  spd=2,hp=2,atk=1,kil=0,
  lv=1,sp=1,
  }
  tts={}blts={}es={}expos={}
  score=0 over=false win=false
  t_sp=0 t_fr=0
  bs_open=false

  l2_itm=0
  l4_b=true
  t_bs=0
  bs_mhp=300

  --music(1)
  i_title()
end

function _update()
  if gg==0 then
    u_title()
    return
  end
  if not u_over() then
    u_tick()
  end
end

function _draw()
  cls(0)
  if gg==0 then
  		d_title()
  		return
  end

  d_stars()

  if over then
    rectfill(0,16,128,96,0)
    if not win then
		    print("game over",44,60,8)
		    print("score: "..score,42,70,7)
		    print("press ❎ to restart",24,80,6)
    else
		    print("congratulations!",36,30,8)
		    print("you win!!!",48,38,7)
		    print("score: "..score,48,60,3)
		    print("press ❎ to restart",30,80,6)
    end
    return
  end

  spr(p.sp,p.x,p.y)

  for b in all(blts) do
    rectfill(b.x+1,b.y,b.x+b.w,b.y+b.h,b.c)
  end

  for e in all(es) do
    if e.fl>0 then
      for i=0,15 do
        pal(i,7)
      end
      e.fl-=1
    end
    spr(e.sp,e.x,e.y)
    pal()
  end

  for ex in all(expos) do
    local c=ex.t<5 and 10 or 9
    local r=5-ex.t/2
    local x=ex.x
    local y=ex.y
    if ex.i==2 or ex.i==3 then
      r/=2
      x+=3
      y+=2
      if ex.i==3 then x-=2 end
    end
    circfill(x,y,r,c)
  end

  print("♥ "..p.hp,108,6*19+2,8)
  print("lv:"..p.lv,100,6*1+2,7)

  print("atk:"..p.atk,100,6*3+2,7)
  print("kil:"..p.kil,100,6*4+2,7)

  print("score:"..score,2,2,7)

  for t1 in all(tts) do
    print(t1.s,2,t1.y,7)
  end

  draw_boss_hpbar()
end

function draw_boss_hpbar()
  if not bs_open then return end

  if i_bs.hp > 0 then
		  local x,y,w,h,c
		  x=0
		  y=0
		  w=flr(128*(i_bs.hp/i_bs.mhp))
		  h=1
		  c=8
		  rectfill(x,y,x+w-1,y+h-1,c)
		else
      o_over(true)
  end
end

-->8
--u

function u_tick()
  u_stars()
  u_sta_e()
  u_mov_p()
  u_fire()
  u_mov_blt()
  u_spawn()
  u_mov_e()
  u_sht_e()
  u_expo()
  u_tt()
end

function u_sta_e()
  for e in all(es) do
    if e.boss then
      t_bs+=1
      if not e.stg then
        e.stg=0
        e.stt=0
        e.frm=0
      end

      e.stt+=1
      if e.stt%5==0 then
        e.frm+=1
      end

      if e.stg==0 then
        e.sp=7
        if t_bs%30==0 then
		        if rnd(5)<=2 then
		          e.stg=1
		          e.stg1=0
		        elseif rnd(5)<=1 then
		          e.stg=2
		          e.stg2=0
		        end
        end
      end

      if e.stg==1 then
        e.sp=e.frm%2+8
        e.stg1+=1
        if e.stg1==60 then
          sk_1(e)
          e.stg=0
        end
      elseif e.stg==2 then
        if e.frm%2==0 then
          e.sp=7
        else
          e.sp=10
        end

        e.stg2+=1
        if e.stg2==120 then
          sk_2(e)
          e.stg=0
        end
      end
    end
  end
end

function u_over()
  if over then
    if btnp(4) or btnp(5) then
      _init()
    end
    return true
  end
end

function u_mov_p()
  -- boost speed
  u_spd=p.spd
  if btn(4) then u_spd*=2 end

  -- move
  p.sp=1
  if btn(0) then p.x-=u_spd p.sp=11 end
  if btn(1) then p.x+=u_spd p.sp=12 end
  if btn(2) then p.y-=u_spd p.sp=14 end
  if btn(3) then p.y+=u_spd p.sp=13 end

  -- limit move
  p.x=mid(0,p.x,120)
  p.y=mid(40,p.y,120)
end

function u_mov_blt()
  for b in all(blts) do
    if b.e then
      b.y+=b.spd
		    if b.y>128 then
		      del(blts,b)
		    end
    else
      b.y-=b.spd
		    if b.y<-5 then
		      del(blts,b)
		    end
    end
  end
end

function u_mov_e()
  for e in all(es) do
    e.y+=e.spd

    if e.y>128 then
      del(es,e)
      o_p_hit(e)
    end

    for b in all(blts) do
      if b.e then
		      if ck_coli(b,p) then
		        o_p_hit_blt(b)
		      end
      else
		      if ck_coli(b,e) then
		        o_e_kil(e,b)
		      end
      end
    end

    if ck_coli(p,e) then
      if e.it then
        sfx(10)
        if e.sp==5 then
          p.atk+=1
        end
        del(es,e)
      else
		      ad_expo(e.x+4,e.y+4)
		      del(es,e)
		      o_p_hit(e)
      end
    end
  end
end

function u_sht_e()
  for e in all(es) do
    if e.sp==4 then
      e.cd=(e.cd or 0)-1
      if e.cd<=0 then
        e.cd=60
        ad_blt(2,e)
      end
    end
    if e.sp==6 then
      e.cd=(e.cd or 0)-1
      if e.cd<=0 then
        e.cd=120
        ad_blt(3,e)
      end
    end
  end
end

function u_fire()
  t_fr+=1
  if t_fr>8 then
  		ad_blt(1)
    t_fr=0
  end
end

function u_spawn()
  t_sp+=1
  if t_sp>30 then
    t_sp=0
    l_sp_1=l_sp[p.lv]
    if l_sp_1 then
      l_sp_1()
    end
  end
end

function u_expo()
  for ex in all(expos) do
    ex.t+=1
    if ex.t>10 then
      del(expos,ex)
    end
  end
end

function u_tt()
  for t1 in all(tts) do
    t1.y-=1
    if t1.y<=100 then
      del(tts,t1)
    end
  end
end

-->8
--func

function ck_coli(a,b)
  return a.x<b.x+b.w
     and a.x+a.w>b.x
     and a.y<b.y+b.h
     and a.y+a.h>b.y
end

function ad_tt(s)
  t1={ s=s,y=120 }
  add(tts,t1)
end

function ad_expo(x,y,i)
  add(expos,{ x=x,y=y,t=0,i=i })
end

function ad_e(sp,hp,spd)
  last_e={
    x=rnd(112),
    y=4,
    spd=spd,
    w=8,
    h=8,
    hp=hp,
    sp=sp,
    fl=0,--flash
    boss=sp==7,
  }
  if last_e.boss then
    last_e.x=60
    last_e.mhp=hp
    i_bs=last_e
  end
  add(es,last_e)
end

function ad_itm(sp)
  last_e={
    x=rnd(112),
    y=4,
    spd=0.4,
    w=8,
    h=8,
    sp=sp,
    fl=0,
    it=true,--item
  }
  add(es,last_e)
end

function ad_blt(i,e)
		if i==1 then
			 add(blts,{
			   x=p.x+2,
			   y=p.y-2,
			   spd=5,
			   w=1,
			   h=2,
			   c=10,
			 })
			 sfx(0)
	 end
	 if i==2 then
			 add(blts,{
			   e=true,
			   x=e.x+2,
			   y=e.y+2,
			   spd=1,
			   w=1,
			   h=2,
			   c=8,
			 })
			 sfx(0)
	 end
	 if i==3 then
			 add(blts,{
			   e=true,
			   x=e.x+1,
			   y=e.y+10,
			   spd=2,
			   w=4,
			   h=4,
			   c=8,
			 })
			 sfx(0)
	 end
end

-->8
--o
function o_over(b_win)
  over=true
  if b_win then
    win=true
  end
  if score>dscore then
		  dset(0,score)
  end
end

function o_p_hit_blt(b)
  ad_expo(b.x,b.y,2)
  o_p_dmg(1)
  del(blts,b)
end

function o_p_hit(e)
  o_p_dmg(1)
end

function o_p_dmg(d)
  p.hp-=d
  sfx(2)
  if p.hp<=0 then
    o_over(false)
  end
end

function o_e_kil(e,b)
  if e.it then return end
  ad_expo(b.x,b.y,3)
  e.fl=3
  e.hp-=p.atk
  del(blts,b)
  if e.hp<=0 then
    ad_expo(e.x+4,e.y+4)
    del(es,e)
    score+=10
    p.kil+=1
    if p.kil%25==0 then
    		p.lv+=1
    		sfx(8)
    		ad_tt("lv +1")
    elseif p.kil%10==0 then
      p.hp+=1
      sfx(3)
      ad_tt("♥ +1")
    else
      sfx(9)
      ad_tt("kill +1")
    end
  end
end

-->8
--levels

function l1()
  if rnd(3)<=1 then
    ad_e(2,1,2)
  else
    ad_e(3,2,0.4)
  end
end

function l2()
  if rnd(2)<=1 then
  	 ad_e(4,4,0.2)
  end
  if rnd(10)<=1 and l2_itm < 2 then
    l2_itm+=1
    ad_itm(5)
  end
end

function l3()
  if rnd(2)<=1 then
  	 ad_e(6,10,0.1)
  end
end

function l4()
  if l4_b then
    l4_b=false
    ad_e(7,bs_mhp,0.02)
    bs_open=true
  end
end

l_sp={
		[1]=l1,
		[2]=l1,
		[3]=l2,
		[4]=l3,
		[5]=l4,
}
-->8
--skills

function sk_1(e)
  for i=-3,3 do
    if rnd(10)<=8 then
					 add(blts,{
					   e=true,
					   x=e.x+(i*8),
					   y=e.y+10,
					   spd=2,
					   w=4,
					   h=4,
					   c=8,
					 })
    end
  end
	 sfx(0)
end

function sk_2(e)
  for i=-3,3 do
    if rnd(10)<=8 then
					 add(blts,{
					   e=true,
					   x=e.x+(i*8),
					   y=e.y+10,
					   spd=4,
					   w=4,
					   h=12,
					   c=12,
					 })
    end
  end
	 sfx(0)
end
-->8
--title

function i_title()
		tit_ship_sx=nil
  tit=0
  stars={}
  for i=1,40 do
    add(stars,{rnd(128),rnd(128),rnd(1)+0.3})
  end
end

function u_title()
  tit+=1
  u_stars()
  if btnp(4) or btnp(5) then
    gg=1
    sfx(0)
  end
end

function d_title()
  cls(0)
  d_stars()

  d_tit_ship()
  d_tit_label()
  d_tit_press()
  d_tit_highscore()

  -- rectfill(0,120,128,128,1)
  -- print("hi "..999999,10,122,7)
end
-->8
--anims

function u_stars()
  for s in all(stars) do
    s[2]+=s[3]
    if s[2]>128 then
      s[2]=0
      s[1]=rnd(128)
    end
  end
end

function d_stars()
  for s in all(stars) do
    pset(s[1],s[2],5)
  end
end

function d_tit_ship()
  local sx=64+cos(tit/60)*20
  local sy=90

  if tit_ship_sx==nil then
    tit_ship_sx=sx
  end

  local sp=1
  if sx<tit_ship_sx then
    sp=11
  end
  if sx>tit_ship_sx then
    sp=12
  end
  tit_ship_sx=sx

  spr(sp,sx,sy)
end

function d_tit_label()
  --local p=abs(sin(tit/20))
  --print("noah's\n  shm-up 01",42,35,7+p*3)

  spr(200,36,20,8,4)
end

function d_tit_press()
  if tit%40<20 then
    print("press ❎ to start",34,70,6)
  end
end

function d_tit_highscore()
  if dscore>=0 then
    print("high score: "..dscore,36,106,9)
  end
end


